    "para_events": {
      "1|sp[2]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "一、年度经营概况"
        }
      ],
      "1|sp[3]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "由原始材料生成 · 年度经营与下年度计划汇报"
        }
      ],
      "1|sp[3]|1": [],
      "1|sp[3]|2": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "2024 年云服务平台全年总收入达到 12.8 亿元，同比增长 38%"
        }
      ],
      "1|sp[3]|3": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "其中订阅收入 8.6 亿元，占总收入的 67%"
        }
      ],
      "2|sp[2]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "一、年度经营概况（续）"
        }
      ],
      "2|sp[3]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "专业版客户数达到 1240 家，较上年增加 310 家"
        }
      ],
      "2|sp[3]|1": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "年度新增签约客户 1870 家，客户续约率为 91%"
        }
      ],
      "3|sp[2]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "一、年度经营概况（续）"
        }
      ],
      "3|sp[3]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "平台整体毛利率为 63.5%，较上年提升 4.2 个百分点"
        }
      ],
      "4|sp[2]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "二、产品能力进展"
        }
      ],
      "4|sp[3]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "实时数据管道上线，日均处理消息量达到 42 亿条"
        }
      ],
      "4|sp[3]|1": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "智能运维模块覆盖 86% 的核心告警场景，平均故障定位时间从 45 分钟缩短到 8 分钟"
        }
      ],
      "4|sp[3]|2": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "多区域部署能力扩展到 6 个可用区，跨区域延迟中位数为 34 毫秒"
        }
      ],
      "5|sp[2]|0": [
        {
          "kind": "text",
          "event_idx": 0,
          "text": "三、客户与生态"
        }
      ],
      "5|sp[3]|0": [
        {
          "kind": "text",
