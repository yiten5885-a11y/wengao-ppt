            "object": "slide9/shape[2]",
            "group_path": ""
          },
          "role": "title",
          "in_image": false,
          "locked": false,
          "required": true
        },
        {
          "id": "p9_u1",
          "text": "跨区域数据同步存在 3 分钟的延迟，影响实时分析场景\n老版本接口未完全下线，维护成本较高，涉及 22 个存量接口\n客户成功团队人手不足，续约预警覆盖率为 74%，低于 85% 的目标",
          "source_ref": {
            "file": "/Users/huangyingteng/WorkBuddy/2026-10-12-00-54-41/wengao-ppt/build/wengao-visual-v13-material-fix/jobs/job-2d3d47df1b8e/input_raw/annual_review_synthetic.generated.pptx",
